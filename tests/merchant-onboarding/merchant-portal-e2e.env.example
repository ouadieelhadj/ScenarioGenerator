WAY4_AURA_STAGING_DIRECTORY=D:/MoneyCore/ScenarioGenerator/runtime/merchant-portal-e2e/way4-staging
WAY4_AURA_MID_GENERATION_ENABLED=false
WAY4_AURA_MID_PREFIX=
WAY4_AURA_MID_NUMERIC_WIDTH=0

