# Independent test profile for Portal -> FuturPayment Acquiring and Portal -> WAY4/AURA Connector.
# Never commit passwords, client secrets or production identifiers here.
PORTAL_TEST_BASE_ENV=runtime/platform-e2e/platform-e2e.env

MERCHANT_ONBOARDING_REST_PORT=8570
ACQUIRING_REST_PORT=8550
WAY4_AURA_CONNECTOR_PORT=8580

MERCHANT_ONBOARDING_DB_URL=jdbc:postgresql://127.0.0.1:5432/scenariogenerator
MERCHANT_ONBOARDING_DB_USER=postgres
ACQUIRING_DB_URL=jdbc:postgresql://127.0.0.1:5432/scenariogenerator
ACQUIRING_DB_USER=postgres
WAY4_AURA_DB_URL=jdbc:postgresql://127.0.0.1:5432/scenariogenerator
WAY4_AURA_DB_USER=postgres

MERCHANT_ONBOARDING_ACQUIRING_V2_ENABLED=true
MERCHANT_ONBOARDING_ACQUIRING_V2_BASE_URL=http://127.0.0.1:8550
MERCHANT_ONBOARDING_OUTBOX_ENABLED=true
MERCHANT_ONBOARDING_WAY4_ENABLED=true
MERCHANT_ONBOARDING_WAY4_BASE_URL=http://127.0.0.1:8580

WAY4_AURA_GENERATION_ENABLED=true
WAY4_AURA_SUBMISSION_ENABLED=false
WAY4_AURA_XSD_ROOT=D:/LanaCash/OpenWay/installationOCI/chargementxmlway4/schemas/xsd/xsd
WAY4_AURA_MAIN_XSD=offline/WAY4ApplFile.xsd
