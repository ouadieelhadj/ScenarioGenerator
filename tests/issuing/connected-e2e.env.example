# Configuration minimale de la recette connectee Issuing.
#
# Copier ce fichier vers :
#   runtime/issuing-connected-e2e/connected-e2e.env
# Le fichier cible est ignore par Git. Ne jamais renseigner de secret dans ce
# modele versionne et ne jamais commiter le fichier runtime.

# PostgreSQL administrateur, utilise uniquement par l'installation idempotente.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scenariogenerator
DB_USER=postgres
DB_PASSWORD=

# Roles dedies des deux applications.
CARD_ISSUING_DB_PASSWORD=
WAY_POS_DB_PASSWORD=

# Materiel local WayPos. Utiliser des valeurs generees pour cette recette et
# ne jamais reutiliser des secrets de production.
WAY_POS_PAN_PEPPER=
WAY_POS_OUTBOX_KEY_HEX=

# Carte et compte de recette autorises. Aucun PAN reel de porteur.
ISSUING_E2E_PAN=
ISSUING_E2E_EXPIRY=
ISSUING_E2E_CURRENCY=504
ISSUING_E2E_BALANCE_MINOR=100000

# Limite memoire optionnelle des JVM lancees simultanement.
ISSUING_E2E_JAVA_TOOL_OPTIONS='-Xms64m -Xmx256m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC'
