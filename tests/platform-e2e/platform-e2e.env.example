# Configuration locale des recettes E2E de la plateforme.
#
# Copier vers runtime/platform-e2e/platform-e2e.env. Le fichier cible est
# ignore par Git. Ne jamais commiter de mot de passe, PAN de recette, PIN,
# cle claire ou secret HSM dans ce modele.

# Outils et PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scenariogenerator
DB_USER=postgres
DB_PASSWORD=
CARD_ISSUING_DB_PASSWORD=
WAY_POS_DB_PASSWORD=

# Issuing / ServerPOS. Valeurs de recette synthetiques seulement.
WAY_POS_LMK_FILE=
WAY_POS_PAN_PEPPER=
WAY_POS_OUTBOX_KEY_HEX=
WAY_POS_TAK_HEX=
WAY_POS_TAMK_HEX=
WAY_POS_TPMK_HEX=
ISSUING_E2E_PAN=
ISSUING_E2E_EXPIRY=
ISSUING_E2E_CURRENCY=504
ISSUING_E2E_BALANCE_MINOR=100000

# Acquisition e-commerce off-us, uniquement si ces routes sont testees.
DMAS_E2E_PAN=
DMAS_E2E_EXPIRY=
SWAM_E2E_PAN=
SWAM_E2E_EXPIRY=

# 3DS sandbox.
THREE_DS_SANDBOX_HMAC_KEY=
THREE_DS_NETWORK_SANDBOX_HMAC_KEY=
THREE_DS_SANDBOX_CHALLENGE_OTP=
THREE_DS_PROGRAM=MASTERCARD

# DMAS / DMCS. Cles, PIN et mots de passe synthetiques de LAB uniquement.
DMAS_ADMIN_PASSWORD=
DMAS_KEK_CLEAR=
DMAS_MDK_CLEAR=
DMAS_TEST_PIN=
DMAS_TEST_PAN=

# SWAM / LIS. Cle synthetique de LAB uniquement.
SWAM_E2E_KEK_CLEAR=
# ZMK de test issue de la ceremonie a deux composantes. La livraison locale
# peut conserver sa forme protegee sous LMK et son KCV ; ne jamais placer les
# composantes claires dans ce modele versionne.
SWAM_E2E_ZMK_PROTECTED=
SWAM_E2E_ZMK_KCV=

# Visa CEMEA VIP / VCMS - contrat du .env local de livraison de test.
# Les valeurs proviennent du document Visa confidentiel autorise et restent
# exclusivement dans la copie runtime ignoree par Git. Elles sont reservees
# aux tests unitaires/globaux qui activent le profil cryptographique Visa.
VISA_TEST_KEYS_FILE=
VISA_TEST_ENCRYPTION_BIN=434179
VISA_TEST_ZCMK_COMPONENT_1=
VISA_TEST_ZCMK_COMPONENT_2=
VISA_TEST_ZCMK_COMPONENT_3=
VISA_TEST_IWK1=
VISA_TEST_IWK2=
VISA_TEST_AWK1=
VISA_TEST_AWK2=
VISA_TEST_CVK=
VISA_TEST_CV2K=
VISA_TEST_PVK1=
VISA_TEST_PVK2=
VISA_TEST_MDK1=
VISA_TEST_MDK2=
VISA_TEST_CAVV_KEY=
VISA_TEST_CAAV_KEY=
VISA_TEST_WSD_KEY=

# Selection du parcours global, separee par des espaces.
PLATFORM_E2E_MODULES="issuing acquiring three-ds mastercard-dmas-dmcs swam visa"
PLATFORM_E2E_CONTINUE_ON_FAILURE=false
