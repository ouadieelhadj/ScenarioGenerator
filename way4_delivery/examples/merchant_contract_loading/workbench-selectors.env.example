# URL et authentification
WAY4_WB_URL=https://workbench-recette.example.invalid/
WAY4_WB_USERNAME=USER_RECETTE
# WAY4_WB_PASSWORD doit être défini séparément et ne doit pas être enregistré.

# Sélecteurs CSS à relever dans l'instance autorisée
WAY4_WB_USERNAME_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_PASSWORD_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_LOGIN_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_NEW_MERCHANT_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_LEGAL_NAME_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_TRADE_NAME_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_REG_NUMBER_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_MID_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_MCC_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_ACCOUNT_CONTRACT_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_TID_SELECTOR=LOCAL_SELECTOR_REQUIRED
WAY4_WB_SUBMIT_SELECTOR=LOCAL_SELECTOR_REQUIRED

# Sécurité : NO par défaut
WAY4_UI_CONFIRM_SUBMIT=NO
WAY4_UI_HEADLESS=NO
