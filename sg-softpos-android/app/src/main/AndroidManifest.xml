  <uses-feature android:name="android.hardware.nfc" android:required="true" />
  <application android:theme="@style/Theme.FuturPaymentSoftPOS" android:allowBackup="false" android:usesCleartextTraffic="false" android:label="FuturPayment SoftPOS">
