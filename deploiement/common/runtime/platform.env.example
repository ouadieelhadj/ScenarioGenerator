# Exemple de configuration locale par poste.
#
# Génération recommandée depuis la racine du dépôt :
#   bash deploiement/common/runtime/detect-env.sh --write platform.env
# Cette commande génère aussi platform-path.sh. Le charger avec :
#   source platform-path.sh
#
# Sinon :
#   cp deploiement/common/runtime/platform.env.example platform.env
#   # puis adapter les chemins.
#
# platform-env.sh charge automatiquement <racine-du-dépôt>/platform.env.
# Priorité : variables déjà exportées > platform.env > valeurs par défaut.
# platform.env est ignoré par Git. Ne jamais y ajouter DB_PASSWORD ni une clé.

ROOT=/d/MoneyCore/ScenarioGenerator
JAVA_HOME_DIR=/d/MoneyCore/jdk-21.0.11
MAVEN_HOME=/d/MoneyCore/idea-2026.1.3.win/plugins/maven/lib/maven3
NODE_HOME=/d/MoneyCore/nodejs
POSTGRES_HOME=/d/MoneyCore/PostgreSQL/18
# Installation portable : répertoire contenant PG_VERSION.
PGDATA=
# Service Windows : nom exact retourné par Get-Service *postgre*.
POSTGRES_SERVICE_NAME=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scenariogenerator
DB_USER=postgres

# Livraison portable Mastercard DMAS (autorisation) + DMC/DMCS (clearing).
# Les chemins relatifs a ROOT sont calcules par les scripts si ces valeurs
# restent absentes. Aucune cle, aucun PIN et aucun mot de passe ici.
DMAS_MEMBER_URL=http://localhost:8084
DMAS_MASTERCARD_URL=http://localhost:8501
DMAS_MASTERCARD_ISO_PORT=8500
DMCS_ACQUIRER_URL=http://localhost:8082
DMCS_ISSUER_URL=http://localhost:8083
DMAS_MEMBER_INTERFACE=DMAS_BANK_A
DMAS_MASTERCARD_INTERFACE=DMAS_MASTERCARD_1
DMAS_MEMBER_GROUP_ID=TESTGRP01
DMAS_MEMBER_BANK_CODE=022905
DMAS_ADMIN_LOGIN=admin
DMCS_BASIC_USER=admin
# Exemples si les LMK sont placees ailleurs :
# DMAS_MEMBER_LMK_FILE=/f/MoneyCore/ScenarioGenerator/keys/dmas-lmk-acq.lmk
# DMAS_MASTERCARD_LMK_FILE=/f/MoneyCore/ScenarioGenerator/keys/dmas-lmk-iss.lmk
