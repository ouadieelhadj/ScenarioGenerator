{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:futurpayment:fraud:RiskAssessmentCompleted.v1",
  "title": "RiskAssessmentCompleted.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "memberId", "assessmentId", "transactionReference", "score", "recommendedAction", "enforcedAction", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "memberId": { "type": "string", "maxLength": 64 },
    "assessmentId": { "type": "string", "format": "uuid" },
    "transactionReference": { "type": "string", "maxLength": 128 },
    "score": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "recommendedAction": { "enum": ["ALLOW", "ALERT", "CHALLENGE", "HOLD", "BLOCK"] },
    "enforcedAction": { "enum": ["ALLOW", "ALERT", "CHALLENGE", "HOLD", "BLOCK"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
