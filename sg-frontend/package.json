{
  "name": "sg-frontend",
  "version": "1.0.0",
  "description": "IHM Angular de la plateforme ScenarioGenerator",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:switchlab": "ng serve futurpayment-switchlab",
    "start:switch": "ng serve futurpayment-switch",
    "start:fraud-gateway": "ng serve futurpayment-fraud-gateway",
    "start:fraud-platform": "ng serve futurpayment-fraud-platform",
    "start:merchant-portal": "ng serve merchant-portal-web",
    "start:merchant-mobile": "ng serve merchant-mobile",
    "start:marketplace": "ng serve futurpayment-marketplace",
    "build": "ng build",
    "build:switchlab": "ng build futurpayment-switchlab",
    "build:switch": "ng build futurpayment-switch",
    "build:fraud-gateway": "ng build futurpayment-fraud-gateway",
    "build:fraud-platform": "ng build futurpayment-fraud-platform",
    "build:merchant-portal": "ng build merchant-portal-web",
    "build:merchant-mobile": "ng build merchant-mobile",
    "build:marketplace": "ng build futurpayment-marketplace",
    "build:marketplace-client-mobile": "ng build futurpayment-marketplace-client-mobile",
    "build:marketplace-merchant-mobile": "ng build futurpayment-marketplace-merchant-mobile",
    "build:marketplace-courier-mobile": "ng build futurpayment-marketplace-courier-mobile",
    "build:marketplace-mobile": "npm run build:marketplace-client-mobile && npm run build:marketplace-merchant-mobile && npm run build:marketplace-courier-mobile",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:apk:debug": "npm run build:merchant-mobile -- --configuration development && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "build:products": "npm run build:switchlab && npm run build:switch && npm run build:fraud-gateway && npm run build:fraud-platform",
    "watch": "ng build --watch --configuration development",
    "test:e2e": "ng build && node ./tools/run-playwright.mjs",
    "test:e2e:marketplace": "node ./tools/run-marketplace-playwright.mjs",
    "test:e2e:report": "playwright show-report",
    "mobile:ios:prepare": "bash tools/ios/build-iphone.sh prepare",
    "mobile:ios:simulator": "bash tools/ios/build-iphone.sh simulator",
    "mobile:ios:archive": "bash tools/ios/build-iphone.sh archive",
    "mobile:ios:check": "python3 tools/ios/verify-ios.py"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@ionic/angular": "^8.8.17",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeng/themes": "^18.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.62.0",
    "typescript": "~5.5.2"
  }
}
