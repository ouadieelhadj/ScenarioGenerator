{
  "name": "sg-frontend",
  "version": "1.0.0",
  "description": "IHM Angular de la plateforme ScenarioGenerator",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:switchlab": "ng serve futurpayment-switchlab",
    "start:switch": "ng serve futurpayment-switch",
    "start:merchant-portal": "ng serve merchant-portal-web",
    "start:merchant-mobile": "ng serve merchant-mobile",
    "build": "ng build",
    "build:switchlab": "ng build futurpayment-switchlab",
    "build:switch": "ng build futurpayment-switch",
    "build:merchant-portal": "ng build merchant-portal-web",
    "build:merchant-mobile": "ng build merchant-mobile",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:apk:debug": "npm run build:merchant-mobile -- --configuration development && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "build:products": "npm run build:switchlab && npm run build:switch",
    "watch": "ng build --watch --configuration development",
    "test:e2e": "ng build && node ./tools/run-playwright.mjs",
    "test:e2e:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@ionic/angular": "^8.8.17",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeng/themes": "^18.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.0",
    "typescript": "~5.5.2"
  }
}
